# ----------------------------------------------------------------------------
# FlowDeck — dashboard environment
# Copy to .env.local for local dev; set the same vars in Vercel for production.
# ----------------------------------------------------------------------------

# Shared secret. The n8n "HTTP Request" node must send this as the
# `x-ingest-token` header when POSTing to /api/ingest.
# Leave empty to disable auth (local dev only).
INGEST_TOKEN=flowdeck-dev-secret

# ----------------------------------------------------------------------------
# These two are for the n8n side (set them in n8n → Settings → Variables),
# shown here for reference — they are NOT read by the dashboard:
#   DASHBOARD_URL = https://your-app.vercel.app   (no trailing slash)
#   INGEST_TOKEN  = <same value as above>
# ----------------------------------------------------------------------------
